<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- CarPlay: riattivare com.apple.developer.carplay-communication quando la
	     capability "CarPlay Communication App" risulta assegnata da Apple al
	     bundle id it.differen.openclaw (portale → Identifiers → Additional
	     Capabilities). Senza, la firma del profilo fallisce. -->

</dict>
</plist>

